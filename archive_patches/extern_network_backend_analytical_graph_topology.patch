+ * structures such as folded-Clos in addition to GPU-only graphs.
+ */
+class GraphTopology final : public Topology {
+  public:
+    /**
+     * Constructor.
+     *
+     * @param graph_file YAML/JSON graph topology file.
+     * @param expected_npus_count expected ASTRA rank/NPU count.
+     */
+    GraphTopology(const std::string& graph_file, int expected_npus_count);
+
+    /**
+     * Construct deterministic shortest path route from source rank to
+     * destination rank.
+     */
+    [[nodiscard]] Route route(DeviceId src, DeviceId dest) const noexcept override;
+
+    /**
+     * Construct all deterministic equal-cost shortest paths from source rank to
+     * destination rank.
+     */
+    [[nodiscard]] std::vector<Route> routes(DeviceId src, DeviceId dest) const noexcept override;
+
+  private:
+    /// rank id -> graph node id
+    std::vector<DeviceId> rank_to_node;
+
+    /// adjacency list of graph node ids
+    std::vector<std::vector<DeviceId>> adjacency;
+
+    /// precomputed shortest graph-node paths indexed by source/destination rank
+    std::vector<std::vector<std::vector<DeviceId>>> shortest_paths_by_rank;
+
+    /// precomputed equal-cost shortest graph-node paths indexed by source/destination rank
+    std::vector<std::vector<std::vector<std::vector<DeviceId>>>> equal_cost_paths_by_rank;
+
+    /**
+     * Load and validate topology from YAML/JSON file.
+     */
+    void load_graph_file(const std::string& graph_file, int expected_npus_count);
+
+    /**
+     * Compute deterministic shortest path between two graph nodes.
+     */
+    [[nodiscard]] std::vector<DeviceId> compute_shortest_path(DeviceId src_node, DeviceId dst_node) const;
+
+    /**
+     * Compute all equal-cost shortest paths between two graph nodes.
+     */
+    [[nodiscard]] std::vector<std::vector<DeviceId>> compute_equal_cost_shortest_paths(
+        DeviceId src_node,
+        DeviceId dst_node) const;
+
+    /**
+     * Precompute deterministic shortest paths between all rank pairs.
+     */
+    void precompute_rank_paths();
+};
+
+}  // namespace NetworkAnalyticalCongestionAware

+std::vector<DeviceId> GraphTopology::compute_shortest_path(const DeviceId src_node, const DeviceId dst_node) const {
+    auto parent = std::vector<DeviceId>(devices_count, -1);
+    auto visited = std::vector<bool>(devices_count, false);
+    auto queue = std::queue<DeviceId>();
+    visited[src_node] = true;
+    queue.push(src_node);
+
+    while (!queue.empty()) {
+        const auto node = queue.front();
+        queue.pop();
+        if (node == dst_node) {
+            break;
+        }
+        for (const auto next : adjacency[node]) {
+            if (!visited[next]) {
+                visited[next] = true;
+                parent[next] = node;
+                queue.push(next);
+            }
+        }
+    }
+
+    if (!visited[dst_node]) {
+        return {};
+    }
+
+    auto path = std::vector<DeviceId>();
+    auto current = dst_node;
+    while (current != -1) {
+        path.push_back(current);
+        current = parent[current];
+    }
+    std::reverse(path.begin(), path.end());
+    return path;
+}
+
+std::vector<std::vector<DeviceId>> GraphTopology::compute_equal_cost_shortest_paths(
+    const DeviceId src_node,
+    const DeviceId dst_node) const {
+    auto distance = std::vector<int>(devices_count, -1);
+    auto parents = std::vector<std::vector<DeviceId>>(devices_count);
+    auto queue = std::queue<DeviceId>();
+    distance[src_node] = 0;
+    queue.push(src_node);
+
+    while (!queue.empty()) {
+        const auto node = queue.front();
+        queue.pop();
+        for (const auto next : adjacency[node]) {
+            if (distance[next] == -1) {
+                distance[next] = distance[node] + 1;
+                parents[next].push_back(node);
+                queue.push(next);
+            } else if (distance[next] == distance[node] + 1) {
+                parents[next].push_back(node);
+            }
+        }
+    }
+
+    if (distance[dst_node] == -1) {
+        return {};
+    }
+
+    auto paths = std::vector<std::vector<DeviceId>>();
+    auto current_path = std::vector<DeviceId>();
+    std::function<void(DeviceId)> backtrack = [&](const DeviceId node) {
+        current_path.push_back(node);
+        if (node == src_node) {
+            auto path = current_path;
+            std::reverse(path.begin(), path.end());
+            paths.push_back(std::move(path));
+        } else {
+            auto node_parents = parents[node];
+            std::sort(node_parents.begin(), node_parents.end());
+            for (const auto parent : node_parents) {
+                backtrack(parent);
+            }
+        }
+        current_path.pop_back();
+    };
+    backtrack(dst_node);
+    std::sort(paths.begin(), paths.end());
+    return paths;
+}
+
+void GraphTopology::precompute_rank_paths() {
+    shortest_paths_by_rank.assign(npus_count, std::vector<std::vector<DeviceId>>(npus_count));
+    equal_cost_paths_by_rank.assign(
+        npus_count,
+        std::vector<std::vector<std::vector<DeviceId>>>(npus_count));
+    for (auto src = 0; src < npus_count; src++) {
+        for (auto dst = 0; dst < npus_count; dst++) {
+            if (src == dst) {
+                shortest_paths_by_rank[src][dst] = {rank_to_node[src]};
+                equal_cost_paths_by_rank[src][dst] = {{rank_to_node[src]}};
+                continue;
+            }
+            const auto paths = compute_equal_cost_shortest_paths(rank_to_node[src], rank_to_node[dst]);
+            if (paths.empty()) {
+                std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                          << "graph is disconnected for rank pair " << src << " -> " << dst << std::endl;
+                std::exit(-1);
+            }
+            equal_cost_paths_by_rank[src][dst] = paths;
+            shortest_paths_by_rank[src][dst] = paths.front();
+        }
+    }
+}
+
+Route GraphTopology::route(const DeviceId src, const DeviceId dest) const noexcept {
+    assert(0 <= src && src < npus_count);
+    assert(0 <= dest && dest < npus_count);
+
+    auto route = Route();
+    for (const auto graph_node : shortest_paths_by_rank[src][dest]) {
+        route.push_back(devices[graph_node]);
+    }
+    return route;
+}
+
+std::vector<Route> GraphTopology::routes(const DeviceId src, const DeviceId dest) const noexcept {
+    assert(0 <= src && src < npus_count);
+    assert(0 <= dest && dest < npus_count);
+
+    auto routes = std::vector<Route>();
+    for (const auto& graph_path : equal_cost_paths_by_rank[src][dest]) {
+        auto route = Route();
+        for (const auto graph_node : graph_path) {
+            route.push_back(devices[graph_node]);
+        }
+        routes.push_back(std::move(route));
+    }
+    return routes;
+}

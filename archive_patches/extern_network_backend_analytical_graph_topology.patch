+GraphTopology::GraphTopology(const std::string& graph_file, const int expected_npus_count) : Topology() {
+    load_graph_file(graph_file, expected_npus_count);
+    precompute_rank_paths();
+}
+
+void GraphTopology::load_graph_file(const std::string& graph_file, const int expected_npus_count) {
+    if (expected_npus_count <= 0) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "expected_npus_count must be positive" << std::endl;
+        std::exit(-1);
+    }
+
+    YAML::Node graph;
+    try {
+        graph = YAML::LoadFile(graph_file);
+    } catch (const YAML::BadFile& e) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) " << e.what() << std::endl;
+        std::exit(-1);
+    }
+
+    try {
+        devices_count = graph["node_count"].as<int>();
+        npus_count = graph["gpu_count"].as<int>();
+    } catch (const YAML::BadConversion& e) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) " << e.what() << std::endl;
+        std::exit(-1);
+    }
+
+    if (npus_count != expected_npus_count) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "gpu_count (" << npus_count << ") does not match npus_count (" << expected_npus_count << ")"
+                  << std::endl;
+        std::exit(-1);
+    }
+    if (devices_count < npus_count) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "node_count must be >= gpu_count" << std::endl;
+        std::exit(-1);
+    }
+
+    dims_count = 1;
+    npus_count_per_dim.push_back(npus_count);
+    adjacency.assign(devices_count, {});
+    instantiate_devices();
+
+    if (graph["rank_nodes"]) {
+        for (const auto& node : graph["rank_nodes"]) {
+            rank_to_node.push_back(node.as<DeviceId>());
+        }
+    } else {
+        for (auto rank = 0; rank < npus_count; rank++) {
+            rank_to_node.push_back(rank);
+        }
+    }
+    if (static_cast<int>(rank_to_node.size()) != npus_count) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "rank_nodes length must equal gpu_count" << std::endl;
+        std::exit(-1);
+    }
+    auto seen_rank_nodes = std::set<DeviceId>();
+    for (const auto node : rank_to_node) {
+        if (node < 0 || node >= devices_count || seen_rank_nodes.count(node) > 0) {
+            std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                      << "rank_nodes must contain unique valid graph node IDs" << std::endl;
+            std::exit(-1);
+        }
+        seen_rank_nodes.insert(node);
+    }
+
+    const auto directed = graph["directed"] ? graph["directed"].as<bool>() : false;
+    if (!graph["edges"] || !graph["edges"].IsSequence()) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "graph file requires an edges sequence" << std::endl;
+        std::exit(-1);
+    }
+
+    auto connected_edges = std::set<std::pair<DeviceId, DeviceId>>();
+    auto max_bandwidth = Bandwidth(0);
+    for (const auto& edge : graph["edges"]) {
+        const auto src = edge["src"].as<DeviceId>();
+        const auto dst = edge["dst"].as<DeviceId>();
+        const auto bandwidth_gbps = edge["bandwidth_gbps"].as<Bandwidth>();
+        const auto latency_ns = edge["latency_ns"] ? edge["latency_ns"].as<Latency>() : Latency(0);
+        const auto bidirectional = edge["bidirectional"] ? edge["bidirectional"].as<bool>() : !directed;
+
+        if (src < 0 || src >= devices_count || dst < 0 || dst >= devices_count || src == dst) {
+            std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                      << "edge contains invalid src/dst" << std::endl;
+            std::exit(-1);
+        }
+        if (bandwidth_gbps <= 0 || latency_ns < 0) {
+            std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                      << "edge bandwidth_gbps must be positive and latency_ns non-negative" << std::endl;
+            std::exit(-1);
+        }
+
+        const auto bandwidth_GBps = bandwidth_gbps / 8.0;
+        max_bandwidth = std::max(max_bandwidth, bandwidth_GBps);
+
+        if (connected_edges.count({src, dst}) > 0 || (bidirectional && connected_edges.count({dst, src}) > 0)) {
+            std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                      << "duplicate graph edge found" << std::endl;
+            std::exit(-1);
+        }
+
+        connect(src, dst, bandwidth_GBps, latency_ns, bidirectional);
+        connected_edges.insert({src, dst});
+        adjacency[src].push_back(dst);
+        if (bidirectional) {
+            connected_edges.insert({dst, src});
+            adjacency[dst].push_back(src);
+        }
+    }
+
+    if (max_bandwidth <= 0) {
+        std::cerr << "[Error] (network/analytical/congestion_aware/GraphTopology) "
+                  << "graph must contain at least one edge" << std::endl;
+        std::exit(-1);
+    }
+    bandwidth_per_dim.push_back(max_bandwidth);
+    for (auto& neighbors : adjacency) {
+        std::sort(neighbors.begin(), neighbors.end());
+    }
+}
